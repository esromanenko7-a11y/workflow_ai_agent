# OpenAI-compatible API key.
# For local Ollama use: ollama
# For training OpenAI proxy use: your proxy key
OPENAI_API_KEY=

# OpenAI-compatible API base URL.
# For local Ollama use: http://localhost:11434/v1
# For training OpenAI proxy use: proxy base URL
OPENAI_BASE_URL=http://localhost:11434/v1

# Default model for /chat and /chat/stream
DEFAULT_MODEL=llama3.2

# LLM request timeout in seconds
REQUEST_TIMEOUT=30

# Redis URL for Cache-Aside
REDIS_URL=redis://localhost:6379/0

# Cache TTL in seconds
CACHE_TTL_SECONDS=3600

# CORS origins as JSON array
CORS_ORIGINS=["http://localhost:3000"]