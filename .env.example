# OpenAI-compatible API key.
# For local Ollama use: ollama
# For training OpenAI proxy use: your proxy key
OPENAI_API_KEY=ollama

# OpenAI-compatible API base URL.
# For local run without Docker use:
# OPENAI_BASE_URL=http://localhost:11434/v1
#
# For Docker Compose with Ollama running on the host machine use:
OPENAI_BASE_URL=http://host.docker.internal:11434/v1

# Default model for /chat and /chat/stream
DEFAULT_MODEL=llama3.2

# LLM request timeout in seconds
REQUEST_TIMEOUT=30

# Redis URL.
# For local run without Docker use:
# REDIS_URL=redis://localhost:6379/0
#
# For Docker Compose use the Redis service name:
REDIS_URL=redis://redis:6379/0

# Cache TTL in seconds
CACHE_TTL_SECONDS=3600

# CORS origins as JSON array
CORS_ORIGINS=["http://localhost:3000"]

# Logging level
LOG_LEVEL=INFO

# Chat module storage backend: json or postgres
CHAT_REPOSITORY=json

# Directory for JSONL chat storage
CHAT_STORAGE_DIR=./var/chats

# Chat context strategy: sliding or hybrid
CHAT_CONTEXT_STRATEGY=sliding

# Number of recent messages to include for sliding context
CHAT_CONTEXT_WINDOW=10

# PostgreSQL connection URL.
# For local run with Postgres exposed from Docker Compose use localhost:
DATABASE_URL=postgresql+asyncpg://app:app@localhost:5432/app

# Telegram bot settings.
# Real BOT_TOKEN must be stored only in local .env and must not be committed.
BOT_TOKEN=replace-me
BACKEND_URL=http://127.0.0.1:8001
BOT_ADMIN_IDS=[]
# Optional proxy for Telegram Bot API.
BOT_PROXY=
# Keep true by default. Use false only for local proxy with self-signed certificates.
BOT_VERIFY_SSL=true

# Internal HTTP API for bot notifications.
INTERNAL_TOKEN=
BOT_API_PORT=9000

# Backend can call this URL to send proactive notifications through the bot.
BOT_URL=http://127.0.0.1:9000
